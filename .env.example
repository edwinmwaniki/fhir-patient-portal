# Copy to `.env` and fill in real values. Never commit the resulting `.env`.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=fhir_portal
POSTGRES_USER=fhir_portal
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Compose ---
WEB_HOST_PORT=8000
NGINX_HOST_PORT=80
