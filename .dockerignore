# Keep the build context small and prevent secrets from leaking into layers.
.git
.gitignore
.github/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# Never bake local envs into the image; env vars are injected at runtime.
.env
.env.*
!.env.example

# Editors / OS
.idea/
.vscode/
.DS_Store

# Test artefacts
.pytest_cache/
.coverage
htmlcov/

# Runtime output
staticfiles/
media/
*.log

# Frontend (added in Task 4)
frontend/node_modules/
frontend/dist/
